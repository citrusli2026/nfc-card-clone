    <string name="app_name">Card Clone</string>
    <string name="welcome_title">Copy your access card</string>
    <string name="welcome_sub">Three steps: read the original, write a blank card, verify automatically.</string>
    <string name="welcome_p1_title">Read baseline</string>
    <string name="welcome_p1_sub">Tap the original card to read its UID and every sector.</string>
    <string name="welcome_p2_title">Write a copy</string>
    <string name="welcome_p2_sub">Tap a UID-writable blank card and write the same data.</string>
    <string name="welcome_p3_title">Compare</string>
    <string name="welcome_p3_sub">Read back instantly and verify byte by byte, key by key.</string>
    <string name="welcome_agree">I only copy cards I am allowed to use, and I understand the risks.</string>
    <string name="welcome_start">Get started</string>
    <string name="welcome_note">Requires a phone with NFC</string>

