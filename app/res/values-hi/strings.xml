    <string name="welcome_title">अपना एक्सेस कार्ड कॉपी करें</string>
    <string name="welcome_sub">तीन चरण: मूल कार्ड पढ़ें, खाली कार्ड लिखें, अपने आप जाँचें।</string>
    <string name="welcome_p1_title">बेसलाइन पढ़ें</string>
    <string name="welcome_p1_sub">UID और सभी सेक्टर पढ़ने के लिए मूल कार्ड को फ़ोन से लगाएँ।</string>
    <string name="welcome_p2_title">कॉपी लिखें</string>
